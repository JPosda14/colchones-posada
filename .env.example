NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Clave de rol de servicio: SOLO en el lado del servidor (nunca en NEXT_PUBLIC_).
# Se usa para el panel admin (CRUD) y para el seed.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Correos (separados por coma) autorizados para entrar al panel admin.
ADMIN_EMAILS=admin@example.com